#!/usr/bin/env python3
"""Universal HarmonyOS PC (OpenHarmony Stage) HAP Builder & Packager for GPUI apps.

Features:
- Accepts either `ohos-app.json`, a `Cargo.toml` with `[package.metadata.ohos]` /
  `[workspace.metadata.ohos]`, or a directory containing either.
- Zero hardcoded user/machine paths: auto-discovers OHOS LLVM NDK, HMOS CLT (hvigor/ohpm/hnpcli),
  `hda` signer, `hdc` debugger, `cargo`, and `binary-sign-tool` via env vars and standard paths.
- Out-of-tree staging & caching (`~/.cache/gpui-ohos-packager`): keeps `gpui-ohos` 100% git-clean,
  reuses `oh_modules` across apps, and repacks updated `.so` / `.hnp` payloads into cached
  unsigned shell HAPs in <0.5s.
- Supports primary + extra Rust/prebuilt `.so` libraries (`extraCargoTargets`, `extraLibs`),
  bundled `.hnp` native packages (`hnpPackages` + `hnpcli`), `rawfile`/`resfile` assets,
  custom ArkTS bridges (`extraEts`, `abilityImports`, `abilityPlugins`), and automatic
  fallback for restricted optional ACLs (`optionalAcls`).
"""

from __future__ import annotations

